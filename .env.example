# ─── Env ────────────────────────────────────────────────
# Directory where you manually place your movie files
MOVIE_DIRECTORY=D:\Movies

# Directory where HLS output will be written (auto-created)
HLS_DIRECTORY=D:\MovieStream\hls

# ─── Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ─── FFmpeg ─────────────────────────────────────────────
# "ffmpeg" assumes FFmpeg is on your system PATH.
# If FFmpeg is installed elsewhere, provide the full path:
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── Quality Profiles ───────────────────────────────────
TRANSCODE_480P=true
TRANSCODE_720P=true
TRANSCODE_1080P=true

# ─── HLS ────────────────────────────────────────────────
# Duration of each HLS segment in seconds
HLS_SEGMENT_DURATION=6

# ─── Transcoding ────────────────────────────────────────
# Maximum number of simultaneous FFmpeg transcoding jobs.
# Default is 1 to avoid overwhelming the machine.
MAX_CONCURRENT_TRANSCODES=1

# Whether to automatically transcode movies on discovery
AUTO_TRANSCODE=true
