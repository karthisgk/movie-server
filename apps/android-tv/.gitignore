# ─── Android build output ────────────────────────────────────────────────────
build/
app/build/
.gradle/

# ─── Local machine config (contains SDK path — differs per machine) ───────────
local.properties

# ─── Gradle wrapper JAR (binary, regenerated by Gradle) ──────────────────────
gradle/wrapper/gradle-wrapper.jar

# ─── Android Studio project files (IDE-specific, not needed for build) ────────
*.iml
.idea/
*.iws
*.ipr
captures/
.navigation/

# ─── Keystore / signing (never commit secrets) ────────────────────────────────
*.jks
*.keystore
release/

# ─── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
