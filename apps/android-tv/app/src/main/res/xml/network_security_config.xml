<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow cleartext HTTP traffic to local LAN IP addresses.
    This is required because the movie server runs on HTTP (not HTTPS) on the local network.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow any 192.168.x.x address -->
        <domain includeSubdomains="false">192.168.0.10</domain>
    </domain-config>
    <!-- Allow all cleartext for local network IPs — TV apps often connect to custom IPs -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
