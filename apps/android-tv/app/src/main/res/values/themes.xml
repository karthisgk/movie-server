<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme using Leanback -->
    <style name="Theme.MovieServerTV" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <!-- Leanback brand/search colors -->
        <item name="colorPrimary">@color/brand_color</item>
        <item name="colorAccent">@color/accent_color</item>
        <!-- Focus ring color for TV -->
        <item name="android:colorControlHighlight">@color/accent_color</item>
        <item name="selectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="selectableItemBackgroundBorderless">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Full-screen player theme (no title bar, black letterbox) -->
    <style name="Theme.MovieServerTV.Player" parent="@style/Theme.Leanback">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
