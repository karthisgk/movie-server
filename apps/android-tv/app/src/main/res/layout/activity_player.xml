<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ExoPlayer surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <!-- Buffering spinner (center) -->
    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_color"
        android:visibility="gone" />

    <!-- Controls overlay — shown/hidden automatically -->
    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/controls_gradient_bg"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <!-- Title row -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingBottom="12dp"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <!-- Seek bar -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:progressTint="@color/accent_color"
            android:thumbTint="@color/accent_color" />

        <!-- Time + buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Current time -->
            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text=" / "
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <!-- Total time -->
            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Rewind -10s -->
            <ImageButton
                android:id="@+id/btn_rewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 10 seconds"
                android:src="@drawable/ic_rewind"
                android:tint="@android:color/white" />

            <!-- Play / Pause -->
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play / Pause"
                android:src="@drawable/ic_pause"
                android:tint="@android:color/white" />

            <!-- Forward +10s -->
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward 10 seconds"
                android:src="@drawable/ic_forward"
                android:tint="@android:color/white" />

            <!-- Audio track button -->
            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Audio tracks"
                android:src="@drawable/ic_audio"
                android:tint="@android:color/white" />

            <!-- Subtitle button -->
            <ImageButton
                android:id="@+id/btn_subtitle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Subtitles"
                android:src="@drawable/ic_subtitle"
                android:tint="@android:color/white" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
