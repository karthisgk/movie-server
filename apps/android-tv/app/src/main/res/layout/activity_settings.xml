<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="640dp"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_title"
            android:textColor="@android:color/white"
            android:textSize="26sp" />

        <!-- SECTION 1: Saved Servers (Placed FIRST) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Saved Servers"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <!-- Refresh Button for Saved Servers -->
            <Button
                android:id="@+id/btn_refresh_servers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_action_selector"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:text="🔄 Refresh"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_healthcheck_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Checking server statuses..."
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layout_saved_servers_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="#333355" />

        <!-- SECTION 2: Add / Edit Custom Server Input Area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="Connect Custom Server"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- Checkbox: Advanced Edit option -->
        <CheckBox
            android:id="@+id/cb_advanced_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:buttonTint="@color/accent_color"
            android:focusable="true"
            android:text="Advanced Edit (Type Full Base URL)"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <!-- Standard Input Layout (IP prefix + last octet + UP/DOWN + Port) -->
        <LinearLayout
            android:id="@+id/layout_standard_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Server IP Address"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <!-- Row: Static prefix + last octet + Up/Down buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ip_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_background"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="14dp"
                    android:text="http://192.168.0."
                    android:textColor="#CCCCCC"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_ip_last_octet"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/saved_server_item_bg"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="10"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:paddingVertical="14dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="16sp" />

                <!-- UP Button -->
                <Button
                    android:id="@+id/btn_ip_up"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_action_selector"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="▲"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <!-- DOWN Button -->
                <Button
                    android:id="@+id/btn_ip_down"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_action_selector"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="▼"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_port_label"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_port"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/saved_server_item_bg"
                android:focusable="true"
                android:fontFamily="monospace"
                android:hint="5000"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#66FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Advanced Input Layout (Full Base URL edit box) -->
        <LinearLayout
            android:id="@+id/layout_advanced_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Server Base URL (http://ip:port)"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_full_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/saved_server_item_bg"
                android:focusable="true"
                android:fontFamily="monospace"
                android:hint="http://192.168.0.10:5000"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#66FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 3 Action Buttons Row: Connect, Save & Connect, Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_primary_selector"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="Connect"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btn_save_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_secondary_selector"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="Save &amp; Connect"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_action_selector"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="@string/settings_cancel"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
